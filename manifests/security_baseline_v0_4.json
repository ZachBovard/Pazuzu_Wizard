    "deployment": {
      "automatic_fail_open": false,
      "hardware_compatibility_check_required": true,
      "initial_mode": "ids",
      "interface_selection": "internal_pre_nat_visibility_preferred",
      "observation_days": 7,
      "performance_baseline_required": true,
      "promotion_to_ips": "human_approved_high_confidence_rules_only",
      "vlan_parent_interface_awareness": true
    },
    "desired": true,
    "engine": "suricata",
    "rule_source_discovery_required": true,
