{
  "attack_vector_matrix": [
    {
      "apply_gate": "hard_fail",
      "controls": [
        "default WAN deny",
        "WireGuard-only remote management",
        "management source-zone restriction"
      ],
      "id": "AV-001",
      "severity": "critical",
      "vector": "WAN exposure of firewall management"
    },
    {
      "apply_gate": "hard_fail",
      "controls": [
        "management-path invariant",
        "local rollback watchdog",
        "confirmed commit",
        "local console recovery"
      ],
      "id": "AV-002",
      "severity": "critical",
      "vector": "Administrator lockout during rule changes"
    },
    {
      "apply_gate": "hard_fail",
      "controls": [
        "separate read and mutation identities",
        "secure local storage",
        "credential rotation",
        "MFA where supported",
        "no control-plane secret storage"
      ],
      "id": "AV-003",
      "severity": "critical",
      "vector": "Stolen API or administrator credential"
    },
    {
      "apply_gate": "hard_fail",
      "controls": [
        "signed intent",
        "local policy revalidation",
        "operation allowlists",
        "human approval",
        "rollback transaction"
      ],
      "id": "AV-004",
      "severity": "critical",
      "vector": "Malicious or compromised control plane sends unsafe intent"
    },
    {
      "apply_gate": "hard_fail",
      "controls": [
        "IPv4 and IPv6 policy parity",
        "default IPv6 deny",
        "ICMPv6-aware validation",
        "unexpected IPv6 alerting"
      ],
      "id": "AV-005",
      "severity": "critical",
      "vector": "IPv6 bypasses IPv4 security policy"
    },
    {
      "apply_gate": "required",
      "controls": [
        "IoT VLAN",
        "client isolation",
        "deny private networks",
        "explicit controller exceptions",
        "IDS and Layer-7 monitoring"
      ],
      "id": "AV-006",
      "severity": "high",
      "vector": "Compromised IoT device moves laterally"
    },
    {
      "apply_gate": "required",
      "controls": [
        "device inventory",
        "quarantine profile",
        "no automatic trust elevation",
        "new-device alert"
      ],
      "id": "AV-007",
      "severity": "high",
      "vector": "Unknown or rogue device joins a trusted network"
    },
    {
      "apply_gate": "required",
      "controls": [
        "force local DNS",
        "block external port 53",
        "block DoT",
        "observe then restrict known DoH",
        "Layer-7 awareness"
      ],
      "id": "AV-008",
      "severity": "high",
      "vector": "DNS filtering bypass through external DNS, DoT or DoH"
    },
    {
      "apply_gate": "hard_fail",
      "controls": [
        "verified HTTPS",
        "format validation",
        "size and entry thresholds",
        "atomic replacement",
        "last-known-good retention"
      ],
      "id": "AV-009",
      "severity": "high",
      "vector": "Poisoned, malformed or unavailable remote blocklist"
    },
    {
      "apply_gate": "hard_fail",
      "controls": [
        "explicit approval",
        "compatibility check",
        "signature verification",
        "baseline backup",
        "rollback plan"
      ],
      "id": "AV-010",
      "severity": "high",
      "vector": "Compromised third-party plugin or package repository"
    },
    {
      "apply_gate": "required",
      "controls": [
        "IDS observation phase",
        "high-confidence promotion only",
        "performance baseline",
        "rollback"
      ],
      "id": "AV-011",
      "severity": "high",
      "vector": "IDS or IPS false positive causes outage"
    },
    {
      "apply_gate": "hard_fail",
      "controls": [
        "hardware capacity gate",
        "interface compatibility test",
        "resource monitoring",
        "staged enablement"
      ],
      "id": "AV-012",
      "severity": "high",
      "vector": "IDS, IPS or Layer-7 inspection exhausts firewall resources"
    },
    {
      "apply_gate": "required",
      "controls": [
        "one peer per device",
        "device-only key storage",
        "narrow AllowedIPs",
        "independent revocation",
        "peer activity alerts"
      ],
      "id": "AV-013",
      "severity": "high",
      "vector": "WireGuard client configuration or private key is stolen"
    },
    {
      "apply_gate": "required",
      "controls": [
        "UPnP disabled",
        "NAT-PMP disabled",
        "published service inventory"
      ],
      "id": "AV-014",
      "severity": "high",
      "vector": "UPnP or NAT-PMP silently publishes an internal service"
    },
    {
      "apply_gate": "hard_fail",
      "controls": [
        "explicit VLAN bindings",
        "native VLAN review",
        "managed switch validation",
        "interzone verification tests"
      ],
      "id": "AV-015",
      "severity": "high",
      "vector": "VLAN hopping or switch misconfiguration defeats segmentation"
    },
    {
      "apply_gate": "required",
      "controls": [
        "scheduled read-only discovery",
        "desired-state comparison",
        "drift alert",
        "no silent remediation"
      ],
      "id": "AV-016",
      "severity": "high",
      "vector": "Configuration drift creates an unreviewed exposure"
    },
    {
      "apply_gate": "hard_fail",
      "controls": [
        "encrypted backups",
        "allowlisted report fields",
        "no private keys",
        "no API secrets",
        "restricted retention"
      ],
      "id": "AV-017",
      "severity": "high",
      "vector": "Backup or diagnostic report leaks secrets or topology"
    },
    {
      "apply_gate": "warning",
      "controls": [
        "country used as risk signal only",
        "monitor-first policy",
        "authentication remains mandatory",
        "no global country deny by default"
      ],
      "id": "AV-018",
      "severity": "medium",
      "vector": "GeoIP evasion or false attribution"
    },
    {
      "apply_gate": "warning",
      "controls": [
        "WAN management remains denied",
        "WireGuard required",
        "TLS required",
        "strong authentication required"
      ],
      "id": "AV-019",
      "severity": "medium",
      "vector": "Randomized management port is mistaken for real security"
    },
    {
      "apply_gate": "hard_fail",
      "controls": [
        "route and interface discovery",
        "overlap rejection",
        "reachability probe",
        "human-readable plan"
      ],
      "id": "AV-020",
      "severity": "high",
      "vector": "Random private subnet overlaps an upstream, VPN or remote network"
    }
  ],
  "description": "Opinionated OPNsense security baseline with managed rule-pack auditing and preservation of unrelated configuration.",
  "device_awareness": {
    "automatic_trust_elevation": false,
    "inventory_enabled": true,
    "minimum_confidence_for_automatic_classification": 0.9,
    "profiles": [
      {
        "default_zone": "trusted",
        "id": "workstation"
      },
      {
        "default_zone": "trusted",
        "id": "mobile"
      },
      {
        "default_zone": "iot",
        "id": "voice_assistant",
        "lateral_access": "deny"
      },
      {
        "default_zone": "iot",
        "discovery_exceptions": "explicit_only",
        "id": "smart_tv_media",
        "lateral_access": "deny"
      },
      {
        "allowed_destinations": [
          "approved_recorder",
          "approved_ntp",
          "approved_dns"
        ],
        "default_zone": "iot",
        "id": "camera",
        "internet_access": "deny_by_default"
      },
      {
        "default_zone": "iot",
        "id": "printer",
        "internet_access": "deny_by_default",
        "trusted_initiated_printing": "explicit_only"
      },
      {
        "default_zone": "management",
        "id": "network_infrastructure"
      },
      {
        "default_zone": "dmz_or_management_by_role",
        "id": "server"
      },
      {
        "default_zone": "quarantine",
        "id": "unknown"
      }
    ],
    "signals": [
      "dhcp_lease",
      "arp_neighbor",
      "ipv6_neighbor",
      "mac_oui",
      "mdns",
      "hostname",
      "zenarmor_application_observation"
    ],
    "unknown_device_zone": "quarantine"
  },
  "dns_security": {
    "block_external_dot_853": true,
    "block_external_tcp_udp_53": true,
    "blocklists": [
      {
        "activation": "blocked_pending_adapter_format_validation",
        "allowlist_supported": true,
        "atomic_update": true,
        "desired": true,
        "download_transport": "verified_https",
        "id": "hagezi_multi_pro_requested",
        "maximum_download_bytes": 50000000,
        "minimum_valid_entries": 1000,
        "preferred_formats_for_evaluation": [
          "wildcard_asterisk",
          "rpz"
        ],
        "reject_html_response": true,
        "requested_format": "adblock",
        "requested_url": "https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/pro.txt",
        "retain_last_known_good": true,
        "update_failure_action": "keep_last_known_good"
      }
    ],
    "clients_must_use_firewall_resolver": true,
    "dns_rebind_protection": true,
    "dnssec_validation": true,
    "doh_policy": "observe_then_block_known_resolvers",
    "local_domain_protection": true,
    "logging": {
      "enabled": true,
      "retention_days": 14,
      "store_full_client_history": false
    },
    "resolver": "opnsense_managed"
  },
  "document_type": "pazuzu_security_baseline",
  "enforcement_mode": "plan_only",
  "generation": {
    "admin_username": {
      "alphabet": "lowercase_ascii_and_digits",
      "exclude_ambiguous_characters": true,
      "generator": "cryptographic_random_identifier",
      "length": 20,
      "notes": "Random usernames reduce predictability but do not replace strong authentication.",
      "prefix": "pa_"
    },
    "management_https_port": {
      "generator": "cryptographic_random_integer",
      "maximum": 49151,
      "minimum": 10240,
      "notes": "Secondary scanning-noise reduction only. Management remains unavailable from WAN. Same range and avoid-list as management_ports.py.",
      "reject_if_in_use": true
    },
    "site_ipv4_supernet": {
      "generator": "random_rfc1918_supernet",
      "preferred_parent": "10.0.0.0/8",
      "prefix_length": 20,
      "reject_overlaps": [
        "wan_connected_networks",
        "local_routes",
        "vpn_routes",
        "existing_interfaces",
        "configured_aliases",
        "192.168.0.0/24",
        "192.168.1.0/24",
        "10.0.0.0/24",
        "10.0.1.0/24"
      ],
      "require_reachability_probe": true
    },
    "storage": "local_agent_encrypted_state",
    "store_generated_values_in_manifest": false,
    "management_ssh_port": {
      "generator": "cryptographic_random_integer",
      "maximum": 49151,
      "minimum": 10240,
      "notes": "A different port from the web GUI. SSH is off until it is turned on.",
      "reject_if_in_use": true
    }
  },
  "geo_awareness": {
    "alerts": [
      "administrative_login_from_unexpected_country",
      "vpn_peer_activity_from_unexpected_country",
      "outbound_connection_to_high_risk_country_when_contextually_unusual"
    ],
    "country_is_not_identity": true,
    "database_updates_required": true,
    "default_mode": "monitor",
    "enabled": true,
    "global_outbound_country_blocking": false,
    "notes": "GeoIP is an imperfect risk signal and must not replace authentication or default-deny policy.",
    "published_service_policy": {
      "allow_country_restrictions_when_explicitly_configured": true,
      "default": "no_published_services"
    }
  },
  "identity_and_access": {
    "firewall_admin": {
      "api_credentials": {
        "control_plane_storage_allowed": false,
        "mutation_identity": "separate",
        "read_only_identity": "separate",
        "rotation_required": true
      },
      "default_named_accounts_disabled_after_validation": true,
      "mfa_required_if_supported": true,
      "password": {
        "generator": "cryptographic_random",
        "minimum_length": 24,
        "never_commit": true,
        "never_log": true,
        "storage": "platform_secure_store"
      },
      "ssh_enabled": false,
      "username_from": "generation.admin_username"
    },
    "remote_management": {
      "management_scope_only": true,
      "method": "wireguard_only",
      "one_peer_per_device": true,
      "peer_expiration_supported": true,
      "peer_revocation": true,
      "private_key_storage": "originating_device_only",
      "required_before_remote_mutation": true,
      "shared_peer_configs": "prohibited"
    },
    "web_management": {
      "allowed_source_zones": [
        "management",
        "wireguard_admin"
      ],
      "guest_access": "deny",
      "iot_access": "deny",
      "port_from": "generation.management_https_port",
      "protocol": "https",
      "trusted_access": "deny_by_default",
      "valid_certificate_required": true,
      "wan_access": "deny"
    },
    "ssh_management": {
      "allowed_source_zones": [
        "management",
        "wireguard_admin"
      ],
      "default_state": "off",
      "listen_on": [
        "management"
      ],
      "port_from": "generation.management_ssh_port",
      "trusted_access": "deny_by_default",
      "wan_access": "deny"
    }
  },
  "ids_ips": {
    "actions": {
      "command_and_control": "drop_after_observation",
      "exploit": "drop_after_observation",
      "high_confidence_malware": "drop_after_observation",
      "informational": "alert",
      "unknown_confidence": "alert"
