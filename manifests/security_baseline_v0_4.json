    },
    {
      "id": "M2",
      "mutation_allowed": false,
      "name": "Compare observed state against baseline"
    },
    {
      "id": "M3",
      "mutation_allowed": false,
      "name": "Generate human-readable security plan and attack-vector report"
    },
    {
      "id": "M4",
